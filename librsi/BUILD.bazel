load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_test")
load("//build:checks.bzl", "host_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "BUILD.bazel",
    "src/lib.rs",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "**",
        ],
        exclude = [
            "out/**",
            "target/**",
            "**/__pycache__/**",
            "**/.ruff_cache/**",
        ],
    ) + ["//librsi/static:sources"],
)

rust_shared_library(
    name = "shared",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ) + [
        "Cargo.toml",
        "//:Cargo.toml",
    ],
    crate_name = "rsi",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = [
        "-Cpanic=abort",
        "-Clink-arg=-Wl,-soname,librsi.so.0",
    ],
    version = VERSION,
    deps = [
        "//:lcs-core",
        "//:peios-uapi",
        "//peios-cabi",
    ] + all_crate_deps(normal = True),
)

# Native local actions must not share rustc's intermediate output directory.
alias(
    name = "static",
    actual = "//librsi/static:static",
)

filegroup(
    name = "rust-sources",
    srcs = glob(["src/**/*.rs"]),
)

filegroup(
    name = "rust-data",
    srcs = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ) + [
        "Cargo.toml",
        "//:Cargo.toml",
    ],
)

rust_test(
    name = "tests",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_name = "rsi",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//:lcs-core",
        "//:peios-uapi",
        "//peios-cabi",
    ] + all_crate_deps(normal = True),
)

# Host GCC/G++, binutils and exact cbindgen are deliberate development inputs.
host_test(
    name = "abi-test",
    size = "small",
    command = "python3 tools/verify-abi.py librsi --shared $(rootpath :shared) --static $(rootpath :static)",
    data = [
        ":shared",
        ":sources",
        ":static",
        "//:kernel-sources",
        "//:tools/verify-abi.py",
    ],
    tags = [
        "external",
        "no-remote",
    ],
)
