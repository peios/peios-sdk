load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//build:static.bzl", "isolated_static")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel"])

filegroup(
    name = "sources",
    srcs = ["BUILD.bazel"],
)

# Separate output directories prevent cdylib/staticlib intermediate object races
# when native builds use local execution without per-action sandboxes.
rust_static_library(
    name = "raw",
    srcs = ["//librsi:rust-sources"],
    compile_data = ["//librsi:rust-data"],
    crate_name = "rsi",
    crate_root = "//librsi:src/lib.rs",
    edition = "2021",
    rustc_flags = ["-Cpanic=abort"],
    version = VERSION,
    visibility = ["//visibility:private"],
    deps = [
        "//:lcs-core",
        "//:peios-uapi",
        "//peios-cabi",
    ] + all_crate_deps(
        package_name = "librsi",
        normal = True,
    ),
)

isolated_static(
    name = "static",
    prefix = "rsi",
    source = ":raw",
)
